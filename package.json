{
  "name": "kritfailer-beta",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && firebase emulators:start --project demo-kritfailer-beta --import .emulator-data --export-on-exit .emulator-data",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "firebase emulators:exec --only auth,database --project demo-kritfailer-beta 'node tests/beta.integration.mjs'"
  },
  "devDependencies": { "@firebase/rules-unit-testing": "3.0.4", "firebase": "10.7.1", "firebase-tools": "14.22.0", "playwright": "1.62.1" }
}
