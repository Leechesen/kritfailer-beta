{
  "rules": {
    ".read": false,
    ".write": false,
    "lobbyV2": {
      ".read": "auth != null",
      "$room": {
        ".write": "(auth != null && ((!data.exists() && newData.child('dmUid').val() === auth.uid && newData.parent().parent().child('roomsV2').child($room).child('dm').val() === auth.uid) || data.child('dmUid').val() === auth.uid)) || (auth != null && root.child('beta').child('campaigns').child($room).child('meta').child('ownerId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['name','dmUid','locked','createdAt','playerCount','dmOnline']) && newData.child('dmUid').val() === newData.parent().parent().child('roomsV2').child($room).child('dm').val()",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "dmUid": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "locked": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "playerCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "dmOnline": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "roomsV2": {
      "$room": {
        ".read": "auth != null && root.child('roomsV2').child($room).child('dm').val() === auth.uid",
        ".write": "auth != null && ((!data.exists() && newData.child('dm').val() === auth.uid) || (!newData.exists() && data.child('dm').val() === auth.uid))",
        ".validate": "newData.hasChildren(['dm','name','createdAt','passwordHash','settings'])",
        "dm": {
          ".read": "auth != null",
          ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || newData.val() === data.val() || (root.child('beta').child('campaigns').child($room).child('meta').child('ownerId').val() === auth.uid && newData.val() === newData.parent().parent().parent().child('beta').child('campaigns').child($room).child('meta').child('dmId').val()))",
          ".write": "auth != null && root.child('beta').child('campaigns').child($room).child('meta').child('ownerId').val() === auth.uid"
        },
        "name": {
          ".read": "auth != null && (auth != null && root.child('roomsV2').child($room).child('dm').val() === auth.uid || (root.child('roomsV2').child($room).child('players').child(auth.uid).exists() && !root.child('roomsV2').child($room).child('banned').child(auth.uid).exists()))",
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "passwordHash": {
          ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^[0-9a-f]{64}$/))"
        },
        "settings": {
          ".read": "auth != null && (auth != null && root.child('roomsV2').child($room).child('dm').val() === auth.uid || (root.child('roomsV2').child($room).child('players').child(auth.uid).exists() && !root.child('roomsV2').child($room).child('banned').child(auth.uid).exists()))",
          ".write": "auth != null && root.child('roomsV2').child($room).child('dm').val() === auth.uid",
          ".validate": "newData.hasChildren(['severity','revision','updatedBy','updatedAt']) && newData.child('updatedBy').val() === newData.parent().child('dm').val() && ((!data.exists() && newData.child('revision').val() === 0 && newData.child('severity').val() === '') || (data.exists() && newData.child('revision').val() === data.child('revision').val() + 1 && newData.child('severity').val().length > 0))",
          "severity": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "revision": {
            ".validate": "newData.isNumber()"
          },
          "updatedBy": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          ".read": "auth != null && (auth != null && root.child('roomsV2').child($room).child('dm').val() === auth.uid || (root.child('roomsV2').child($room).child('players').child(auth.uid).exists() && !root.child('roomsV2').child($room).child('banned').child(auth.uid).exists()))",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || (auth != null && root.child('roomsV2').child($room).child('dm').val() === auth.uid))",
            ".write": "auth != null && ((auth != null && root.child('roomsV2').child($room).child('dm').val() === auth.uid) || (auth.uid === $uid && root.child('roomsV2').child($room).child('dm').exists() && !root.child('roomsV2').child($room).child('banned').child($uid).exists() && (data.exists() || newData.child('joinProof').val() === root.child('roomsV2').child($room).child('passwordHash').val())))",
            ".validate": "newData.hasChildren(['name','joinedAt','joinProof']) && (newData.parent().parent().child('dm').val() === $uid || newData.child('joinProof').val() === newData.parent().parent().child('passwordHash').val())",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === now) || newData.val() === data.val())"
            },
            "joinProof": {
              ".validate": "newData.isString()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "presence": {
          ".read": "auth != null && (auth != null && root.child('roomsV2').child($room).child('dm').val() === auth.uid || (root.child('roomsV2').child($room).child('players').child(auth.uid).exists() && !root.child('roomsV2').child($room).child('banned').child(auth.uid).exists()))",
          "$uid": {
            ".write": "auth != null && ((auth != null && root.child('roomsV2').child($room).child('dm').val() === auth.uid) || (auth.uid === $uid && (auth != null && (auth != null && root.child('roomsV2').child($room).child('dm').val() === auth.uid || (root.child('roomsV2').child($room).child('players').child(auth.uid).exists() && !root.child('roomsV2').child($room).child('banned').child(auth.uid).exists())))))",
            "$connection": {
              ".validate": "newData.val() === true"
            }
          }
        },
        "banned": {
          ".read": "auth != null && root.child('roomsV2').child($room).child('dm').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || (auth != null && root.child('roomsV2').child($room).child('dm').val() === auth.uid))",
            ".write": "(auth != null && root.child('roomsV2').child($room).child('dm').val() === auth.uid) && $uid !== auth.uid",
            ".validate": "newData.val() === true"
          }
        },
        "results": {
          ".read": "auth != null && root.child('roomsV2').child($room).child('dm').val() === auth.uid",
          "$target": {
            ".read": "(auth != null && (auth != null && root.child('roomsV2').child($room).child('dm').val() === auth.uid || (root.child('roomsV2').child($room).child('players').child(auth.uid).exists() && !root.child('roomsV2').child($room).child('banned').child(auth.uid).exists()))) && auth.uid === $target",
            ".indexOn": [
              "ts"
            ],
            "$event": {
              ".write": "auth != null && ((!newData.exists() && (auth != null && root.child('roomsV2').child($room).child('dm').val() === auth.uid)) || (!data.exists() && (auth != null && (auth != null && root.child('roomsV2').child($room).child('dm').val() === auth.uid || (root.child('roomsV2').child($room).child('players').child(auth.uid).exists() && !root.child('roomsV2').child($room).child('banned').child(auth.uid).exists()))) && newData.child('actorId').val() === auth.uid && ((auth.uid === $target && newData.child('kind').val() === 'roll') || (auth != null && root.child('roomsV2').child($room).child('dm').val() === auth.uid))))",
              ".validate": "newData.hasChildren(['entryId','label','severity','settingsRevision','effect','actorId','actorName','targetId','targetName','datasetVersion','kind','clientTs','ts']) && newData.child('targetId').val() === $target && newData.child('actorName').val() === newData.parent().parent().parent().child('players').child(auth.uid).child('name').val() && newData.child('targetName').val() === newData.parent().parent().parent().child('players').child($target).child('name').val() && ((newData.child('kind').val() === 'roll' && newData.child('severity').val() === newData.parent().parent().parent().child('settings').child('severity').val() && newData.child('settingsRevision').val() === newData.parent().parent().parent().child('settings').child('revision').val() && newData.child('settingsRevision').val() > 0) || (newData.child('kind').val() === 'assignment' && (auth != null && root.child('roomsV2').child($room).child('dm').val() === auth.uid)))",
              "entryId": {
                ".validate": "newData.isString() && newData.val().length <= 512"
              },
              "label": {
                ".validate": "newData.isString() && newData.val().length <= 240"
              },
              "severity": {
                ".validate": "newData.isString() && newData.val().length <= 80"
              },
              "effect": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4000"
              },
              "settingsRevision": {
                ".validate": "newData.isNumber() && newData.val() >= 1"
              },
              "actorId": {
                ".validate": "newData.isString() && newData.val().length <= 128"
              },
              "actorName": {
                ".validate": "newData.isString() && newData.val().length <= 30"
              },
              "targetId": {
                ".validate": "newData.isString() && newData.val().length <= 128"
              },
              "targetName": {
                ".validate": "newData.isString() && newData.val().length <= 30"
              },
              "datasetVersion": {
                ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
              },
              "kind": {
                ".validate": "newData.val() === 'roll' || newData.val() === 'assignment'"
              },
              "clientTs": {
                ".validate": "newData.isNumber()"
              },
              "ts": {
                ".validate": "newData.isNumber() && newData.val() === now"
              },
              "roleplay": {
                ".validate": "newData.hasChildren()",
                "$index": {
                  ".validate": "($index === '0' || $index === '1') && newData.isString() && newData.val().length <= 4000"
                }
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "overlayConfig": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('roomsV2').child($room).child('dm').val() === auth.uid",
          ".validate": "newData.hasChildren(['theme'])",
          "theme": {
            ".validate": "newData.isString() && (newData.val() === 'grimoire' || newData.val() === 'inferno' || newData.val() === 'astral' || newData.val() === 'parchment' || newData.val() === 'nordic' || newData.val() === 'comic' || newData.val() === 'ice')"
          },
          "$other": {
            ".validate": false
          }
        },
        "overlay": {
          ".read": "auth != null",
          ".write": "(auth != null && (auth != null && root.child('roomsV2').child($room).child('dm').val() === auth.uid || (root.child('roomsV2').child($room).child('players').child(auth.uid).exists() && !root.child('roomsV2').child($room).child('banned').child(auth.uid).exists()))) && newData.child('actorId').val() === auth.uid",
          ".validate": "newData.hasChildren(['id','effect','severity','targetId','player','title','ts']) && newData.parent().child('results').child(newData.child('targetId').val()).child(newData.child('id').val()).exists() && newData.child('effect').val() === newData.parent().child('results').child(newData.child('targetId').val()).child(newData.child('id').val()).child('effect').val() && newData.child('severity').val() === newData.parent().child('results').child(newData.child('targetId').val()).child(newData.child('id').val()).child('severity').val() && newData.child('player').val() === newData.parent().child('results').child(newData.child('targetId').val()).child(newData.child('id').val()).child('targetName').val() && newData.child('title').val() === newData.parent().child('results').child(newData.child('targetId').val()).child(newData.child('id').val()).child('label').val() && newData.child('ts').val() === newData.parent().child('results').child(newData.child('targetId').val()).child(newData.child('id').val()).child('ts').val()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "beta": {
      "profiles": {
        "$uid": {
          ".validate": "newData.hasChildren(['name','createdAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 30 && newData.val().length > 0"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === now) || newData.val() === data.val())"
          },
          "$other": {
            ".validate": false
          },
          ".read": "auth != null && auth.token.email != null && auth.uid === $uid",
          ".write": "auth != null && auth.token.email != null && auth.uid === $uid && newData.exists()"
        }
      },
      "characters": {
        "$uid": {
          ".read": "auth != null && auth.token.email != null && auth.uid === $uid",
          ".write": "auth != null && auth.token.email != null && auth.uid === $uid",
          "$character": {
            ".validate": "newData.hasChildren(['name','species','className','level','notes','updatedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 30 && newData.val().length > 0"
            },
            "species": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "className": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "level": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20 && newData.val() % 1 === 0"
            },
            "notes": {
              ".validate": "newData.isString() && newData.val().length <= 2000"
            },
            "updatedAt": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "myCampaigns": {
        "$uid": {
          ".read": "auth != null && auth.token.email != null && auth.uid === $uid",
          "$campaign": {
            ".write": "auth != null && auth.token.email != null && auth.uid === $uid",
            ".validate": "newData.val() === true && newData.parent().parent().parent().child('campaigns').child($campaign).child('members').child($uid).exists()"
          }
        }
      },
      "invitations": {
        "$code": {
          ".validate": "newData.hasChildren(['campaignId','name'])",
          "campaignId": {
            ".validate": "newData.isString() && newData.val().length <= 128 && newData.val().length > 0"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 30 && newData.val().length > 0"
          },
          "$other": {
            ".validate": false
          },
          ".read": "auth != null && auth.token.email != null",
          ".write": "auth != null && auth.token.email != null && newData.exists() && newData.parent().parent().child('campaigns').child(newData.child('campaignId').val()).child('meta').child('ownerId').val() === auth.uid && newData.parent().parent().child('campaigns').child(newData.child('campaignId').val()).child('meta').child('inviteCode').val() === $code"
        }
      },
      "campaigns": {
        "$campaign": {
          ".read": "auth != null && auth.token.email != null && root.child('beta').child('campaigns').child($campaign).child('members').child(auth.uid).exists()",
          "meta": {
            ".validate": "newData.hasChildren(['name','ownerId','dmId','inviteCode','createdAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 30 && newData.val().length > 0"
            },
            "ownerId": {
              ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || newData.val() === data.val())"
            },
            "dmId": {
              ".validate": "newData.isString() && newData.parent().parent().child('members').child(newData.val()).exists()"
            },
            "inviteCode": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{32}$/) && (!data.exists() || newData.val() === data.val())"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === now) || newData.val() === data.val())"
            },
            "$other": {
              ".validate": false
            },
            ".write": "auth != null && auth.token.email != null && newData.exists() && ((!data.exists() && newData.child('ownerId').val() === auth.uid && newData.child('dmId').val() === auth.uid) || data.child('ownerId').val() === auth.uid)"
          },
          "members": {
            "$uid": {
              ".validate": "newData.hasChildren(['name','characterId','characterName','joinedAt','inviteProof']) && ((newData.child('characterId').val() === '' && newData.child('characterName').val() === '') || (newData.parent().parent().parent().parent().child('characters').child($uid).child(newData.child('characterId').val()).child('name').val() === newData.child('characterName').val()))",
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 30 && newData.val().length > 0"
              },
              "characterId": {
                ".validate": "newData.isString() && newData.val().length <= 128"
              },
              "characterName": {
                ".validate": "newData.isString() && newData.val().length <= 30"
              },
              "joinedAt": {
                ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === now) || newData.val() === data.val())"
              },
              "inviteProof": {
                ".validate": "newData.val() === newData.parent().parent().parent().child('meta').child('inviteCode').val()"
              },
              "$other": {
                ".validate": false
              },
              ".read": "auth != null && auth.token.email != null && auth.uid === $uid",
              ".write": "auth != null && auth.token.email != null && auth.uid === $uid && newData.exists() && (newData.parent().parent().child('meta').child('ownerId').val() === auth.uid || newData.child('inviteProof').val() === root.child('beta').child('campaigns').child($campaign).child('meta').child('inviteCode').val())"
            }
          },
          "availability": {
            "$month": {
              ".validate": "$month.matches(/^20[0-9]{2}-(0[1-9]|1[0-2])$/)",
              "$day": {
                ".validate": "$day.matches(/^(0[1-9]|[12][0-9]|3[01])$/)",
                "$uid": {
                  ".validate": "newData.hasChildren(['status','from','until','note','updatedAt']) && (newData.child('from').val() === '' || newData.child('until').val() === '' || newData.child('from').val() < newData.child('until').val())",
                  "status": {
                    ".validate": "newData.val() === 'yes' || newData.val() === 'maybe' || newData.val() === 'no'"
                  },
                  "from": {
                    ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/))"
                  },
                  "until": {
                    ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/))"
                  },
                  "note": {
                    ".validate": "newData.isString() && newData.val().length <= 160"
                  },
                  "updatedAt": {
                    ".validate": "newData.val() === now"
                  },
                  "$other": {
                    ".validate": false
                  },
                  ".write": "auth != null && auth.token.email != null && root.child('beta').child('campaigns').child($campaign).child('members').child(auth.uid).exists() && auth.uid === $uid"
                }
              }
            }
          },
          "session": {
            ".validate": "newData.hasChildren(['date','time','timezone','note','updatedBy','updatedAt'])",
            "date": {
              ".validate": "newData.isString() && newData.val().matches(/^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/)"
            },
            "time": {
              ".validate": "newData.isString() && newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/)"
            },
            "timezone": {
              ".validate": "newData.val() === 'Europe/Prague'"
            },
            "note": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "updatedBy": {
              ".validate": "newData.val() === auth.uid"
            },
            "updatedAt": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            },
            ".write": "auth != null && auth.token.email != null && root.child('beta').child('campaigns').child($campaign).child('members').child(auth.uid).exists() && root.child('beta').child('campaigns').child($campaign).child('meta').child('dmId').val() === auth.uid"
          },
          "chat": {
            ".indexOn": [
              "ts"
            ],
            "$message": {
              ".validate": "newData.hasChildren(['uid','name','body','ts'])",
              "uid": {
                ".validate": "newData.val() === auth.uid"
              },
              "name": {
                ".validate": "newData.val() === root.child('beta').child('campaigns').child($campaign).child('members').child(auth.uid).child('name').val()"
              },
              "body": {
                ".validate": "newData.isString() && newData.val().length <= 2000 && newData.val().length > 0"
              },
              "ts": {
                ".validate": "newData.val() === now"
              },
              "$other": {
                ".validate": false
              },
              ".write": "auth != null && auth.token.email != null && root.child('beta').child('campaigns').child($campaign).child('members').child(auth.uid).exists() && !data.exists() && newData.exists() && newData.child('uid').val() === auth.uid"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
